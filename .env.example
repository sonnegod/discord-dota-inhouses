DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
PUBLIC_BASE_URL=http://localhost:3000
HTTP_ADDR=127.0.0.1:8080
# Replace with the same absolute path for both processes before running them.
DB_PATH=./inhouses.db
# Initial queue mode: fifo, role, or captain (later /settings changes persist in SQLite).
QUEUE_MODE=fifo
TEST_SOLO_LOBBY=false
STEAM_USERNAME=
STEAM_PASSWORD=
STEAM_ACCESS_TOKEN=
# Base lobby name; the worker appends the match number (for example, Discord Inhouse #11).
LOBBY_NAME=Discord Inhouse
LOBBY_GAME_MODE=cm
# Leave blank for a new random password per lobby, or set a fixed password.
LOBBY_PASS_KEY=
# Dota lobby server IDs (availability can change; match your in-game server list):
# 0 unspecified; 1 US West; 2 US East; 3 Europe; 4 Korea; 5 Singapore
# 6 Dubai; 7 Australia; 8 Stockholm; 9 Austria; 10 Brazil; 11 South Africa
# 12 China PW Telecom Shanghai; 13 China PW Unicom; 14 Chile; 15 Peru
# 16 India; 17 China PW Telecom Guangzhou; 18 China PW Telecom Zhejiang
# 19 Japan; 20 China PW Telecom Wuhan
LOBBY_SERVER_REGION=0
